# Sepolia VRF v2.5 subscription ID (a public on-chain value, not a secret).
VRF_SUBSCRIPTION_ID=

# Public Sepolia endpoint, no API key required. Swap in your own provider
# (Alchemy/Infura/etc.) if you hit rate limits — those URLs contain a key, so
# keep them in .env only, never in .env.example.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer key. Leave empty here; set it only in your gitignored .env.
PRIVATE_KEY=
